{
  "name": "logistics-server",
  "version": "1.0.0",
  "description": "Warehouse and inventory API (Express + MongoDB)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate:roles": "node -e \"require('dotenv').config(); require('./config/db').connectDB().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.1.1",
    "socket.io": "^4.8.3"
  }
}
